# App Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# Database Configuration (PostgreSQL Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/zhou_db?schema=public"

# Redis Configuration (Token Blacklist & Caching)
REDIS_URL="redis://localhost:6379"

# Authentication & JWT
JWT_SECRET="your_jwt_secret_key"
JWT_EXPIRES_IN="1d"

# Google OAuth (Hanya untuk Klien)
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Resend Email Service (Email Transaksional)
RESEND_API_KEY="your_resend_api_key"
RESEND_FROM_EMAIL="Zhou Consulting <noreply@zhouconsulting.com>"

# Supabase Storage (Object Storage & Signed URL Dokumen)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
SUPABASE_BUCKET_DOCUMENTS="zhou-documents"

# Sentry (Error Monitoring & Observability)
SENTRY_DSN="your_sentry_dsn"
