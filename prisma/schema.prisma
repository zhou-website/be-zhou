// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 1. Users (Multi-role: CLIENT/USER, ADMIN, SUPERADMIN)
model User {
  id                  Int       @id @default(autoincrement())
  name                String    @db.VarChar(255)
  email               String    @unique @db.VarChar(255)
  password            String?   @db.VarChar(255) // Nullable for Google OAuth clients
  role                String    @default("USER") @db.VarChar(50) // USER, ADMIN, SUPERADMIN
  phone               String?   @db.VarChar(50)
  company_name        String?   @db.VarChar(255)
  is_active           Boolean   @default(true)
  avatar_url          String?   @db.VarChar(500)
  reset_token         String?   @db.VarChar(255)
  reset_token_expires DateTime? @db.Timestamp(6)
  created_at          DateTime  @default(now()) @db.Timestamp(6)
  updated_at          DateTime  @updatedAt @db.Timestamp(6)

  // Relations
  consultations_projects ConsultationProject[]
  audit_logs             AuditLog[]            @relation("AdminAuditLogs")
  client_audit_logs      AuditLog[]            @relation("ClientAuditLogs")
  company_profiles       CompanyProfile[]
  regulations            Regulation[]
  education_contents     EducationContent[]
  project_documents      ProjectDocument[]

  @@map("users")
}

// 2. Services (Accounting Service, Business Financial Consulting, Legal, Tax Service Core)
model Service {
  id           Int      @id @default(autoincrement())
  service_code String   @unique @db.VarChar(50)
  service_name String   @db.VarChar(255)
  category     String   @db.VarChar(100)
  description  String?  @db.Text
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamp(6)
  updated_at   DateTime @updatedAt @db.Timestamp(6)

  // Relations
  consultations_projects ConsultationProject[]

  @@map("services")
}

// 3. Consultations Projects (Client Project Ticket & Engagement)
model ConsultationProject {
  id               Int      @id @default(autoincrement())
  project_code     String   @unique @db.VarChar(50)
  client_id        Int
  service_id       Int
  title            String   @db.VarChar(255)
  description      String?  @db.Text
  status           String   @default("IN_PROGRESS") @db.VarChar(50) // IN_PROGRESS, COMPLETED
  progress_percent Int      @default(0)
  created_at       DateTime @default(now()) @db.Timestamp(6)
  updated_at       DateTime @updatedAt @db.Timestamp(6)

  // Relations
  client     User              @relation(fields: [client_id], references: [id])
  service    Service           @relation(fields: [service_id], references: [id])
  tasks      ProjectTask[]
  documents  ProjectDocument[]
  audit_logs AuditLog[]

  @@map("consultations_projects")
}

// 4. Project Tasks (Checklist Penugasan)
model ProjectTask {
  id           Int      @id @default(autoincrement())
  project_id   Int
  task_name    String   @db.VarChar(255)
  is_completed Boolean  @default(false)
  updated_at   DateTime @updatedAt @db.Timestamp(6)

  // Relations
  project ConsultationProject @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@map("project_tasks")
}

// 5. Project Documents (Hasil Laporan / Kertas Kerja / PDF & XLSX)
model ProjectDocument {
  id          Int      @id @default(autoincrement())
  project_id  Int
  file_name   String   @db.VarChar(255)
  file_path   String   @db.VarChar(500)
  file_size   String   @db.VarChar(50)
  file_type   String   @db.VarChar(50) // PDF, XLSX, DOCX
  sha_hash    String?  @db.VarChar(128)
  uploaded_by Int
  created_at  DateTime @default(now()) @db.Timestamp(6)

  // Relations
  project  ConsultationProject @relation(fields: [project_id], references: [id], onDelete: Cascade)
  uploader User                @relation(fields: [uploaded_by], references: [id])

  @@map("project_documents")
}

// 6. Audit Logs (Append-Only Log for Admin & Operational Actions)
model AuditLog {
  id            Int      @id @default(autoincrement())
  admin_id      Int
  client_id     Int?
  project_id    Int?
  action        String   @db.VarChar(100) // STATUS_UPDATE, DOCUMENT_UPLOAD, ADMIN_DEACTIVATE, etc.
  status_before String?  @db.VarChar(50)
  status_after  String?  @db.VarChar(50)
  file_name     String?  @db.VarChar(255)
  description   String   @db.Text
  created_at    DateTime @default(now()) @db.Timestamp(6)

  // Relations
  admin   User                 @relation("AdminAuditLogs", fields: [admin_id], references: [id])
  client  User?                @relation("ClientAuditLogs", fields: [client_id], references: [id])
  project ConsultationProject? @relation(fields: [project_id], references: [id])

  @@map("audit_logs")
}

// 7. Company Profiles (CMS Profile & Visi Misi)
model CompanyProfile {
  id          Int      @id @default(autoincrement())
  section_key String   @unique @db.VarChar(100)
  title       String   @db.VarChar(255)
  content     String   @db.Text
  updated_by  Int?
  updated_at  DateTime @updatedAt @db.Timestamp(6)

  // Relations
  updater User? @relation(fields: [updated_by], references: [id])

  @@map("company_profiles")
}

// 8. Regulations (CMS Regulasi Pajak & Unduhan)
model Regulation {
  id              Int      @id @default(autoincrement())
  title           String   @db.VarChar(255)
  regulation_type String   @db.VarChar(100)
  file_path       String   @db.VarChar(500)
  file_size       String   @db.VarChar(50)
  uploaded_by     Int?
  created_at      DateTime @default(now()) @db.Timestamp(6)

  // Relations
  uploader User? @relation(fields: [uploaded_by], references: [id])

  @@map("regulations")
}

// 9. Tax Rates (CMS Kurs Pajak Mingguan)
model TaxRate {
  id                   Int       @id @default(autoincrement())
  currency_code        String    @db.VarChar(10)
  rate_value           Decimal   @db.Decimal(12, 2)
  effective_start_date DateTime  @db.Date
  effective_end_date   DateTime? @db.Date
  created_at           DateTime  @default(now()) @db.Timestamp(6)

  @@map("tax_rates")
}

// 10. Education Contents (CMS Artikel Literasi Pajak & Panduan)
model EducationContent {
  id           Int      @id @default(autoincrement())
  title        String   @db.VarChar(255)
  category     String   @db.VarChar(100)
  content_type String   @db.VarChar(50) // ARTICLE, GUIDE
  body         String   @db.Text
  file_path    String?  @db.VarChar(500)
  created_by   Int?
  created_at   DateTime @default(now()) @db.Timestamp(6)
  updated_at   DateTime @updatedAt @db.Timestamp(6)

  // Relations
  creator User? @relation(fields: [created_by], references: [id])

  @@map("education_contents")
}

// 11. Career Jobs (Lowongan Kerja)
model CareerJob {
  id             Int      @id @default(autoincrement())
  position_code  String   @unique @db.VarChar(50)
  position_title String   @db.VarChar(255)
  level          String   @db.VarChar(100)
  location       String   @db.VarChar(100)
  description    String   @db.Text
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now()) @db.Timestamp(6)
  updated_at     DateTime @updatedAt @db.Timestamp(6)

  // Relations
  applications JobApplication[]

  @@map("career_jobs")
}

// 12. Job Applications (Pelamar Kerja & CV)
model JobApplication {
  id              Int      @id @default(autoincrement())
  job_id          Int
  applicant_name  String   @db.VarChar(255)
  applicant_email String   @db.VarChar(255)
  applicant_phone String   @db.VarChar(50)
  cv_file_path    String   @db.VarChar(500)
  applied_at      DateTime @default(now()) @db.Timestamp(6)

  // Relations
  job CareerJob @relation(fields: [job_id], references: [id])

  @@map("job_applications")
}

// 13. Chatbot FAQs (Rule-Based Decision Tree)
model ChatbotFaq {
  id              Int    @id @default(autoincrement())
  category        String @db.VarChar(100)
  question        String @db.Text
  answer_template String @db.Text

  @@map("chatbot_faqs")
}

// 14. Site Settings (Konfigurasi Global & Kontak CS)
model SiteSetting {
  id             Int      @id @default(autoincrement())
  setting_key    String   @unique @db.VarChar(100)
  setting_value  String   @db.VarChar(500)
  closed_message String?  @db.Text
  updated_at     DateTime @updatedAt @db.Timestamp(6)

  @@map("site_settings")
}
